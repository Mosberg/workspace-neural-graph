{
  "name": "workspace-neural-graph",
  "displayName": "Workspace Neural Graph & Dependency Cockpit",
  "description": "High-performance visual interactive neural graphs, dependency matrix, circular detection, and workspace CRUD.",
  "version": "1.3.0",
  "publisher": "Mosberg",
  "author": {
    "name": "Mosberg",
    "url": "https://github.com/Mosberg/workspace-neural-graph"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Mosberg/workspace-neural-graph.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onCommand:workspaceNeuralGraph.openView",
    "onCommand:workspaceNeuralGraph.refresh"
  ],
  "main": "./out/extension.js",
  "extensionKind": ["ui"],
  "contributes": {
    "commands": [
      {
        "command": "workspaceNeuralGraph.openView",
        "title": "Neural Graph: Open Workspace Visualizer",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "workspaceNeuralGraph.refresh",
        "title": "Neural Graph: Rescan Workspace",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "workspaceNeuralGraph.openView",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "workspaceNeuralGraph.refresh",
          "when": "view == workspaceNeuralGraph",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Workspace Neural Graph",
      "properties": {
        "neuralGraph.excludePatterns": {
          "type": "array",
          "default": [
            "node_modules",
            ".git",
            ".vscode",
            "dist",
            "out",
            "build",
            ".cache",
            "__pycache__",
            "target"
          ],
          "description": "List of directory or file patterns to ignore during scan."
        },
        "neuralGraph.detectCircularDependencies": {
          "type": "boolean",
          "default": true,
          "description": "Highlight cyclic dependency chains in bright red."
        },
        "neuralGraph.maxFileSizeKB": {
          "type": "number",
          "default": 1024,
          "description": "Maximum file size in KB to scan for import/dependency links."
        },
        "neuralGraph.defaultLayout": {
          "type": "string",
          "enum": [
            "force",
            "tree",
            "radial"
          ],
          "default": "force",
          "description": "Initial layout engine to render on open."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@types/d3": "^7.4.3",
    "3d-force-graph": "^1.80.1",
    "d3": "^7.9.2"
  }
}
